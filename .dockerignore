.git
.gitignore
.pytest_cache
pytest.ini
__pycache__
*.pyc
.DS_Store

venv/
env/

# Not needed in the deployed image - see Dockerfile's COPY list, which
# copies only what webapp/ actually imports.
main.py
run_viz.py
inspect_grid.py
sensitivity.py
requirements.txt
notebooks/
scripts/
abm/simulation_analysis/
experiments/calibration/
experiments/care_seeking/
experiments/shocks/
experiments/vaccination/

cache/
outputs/
# Every data/ folder, not just the root one (Docker, unlike git, matches a bare
# "data/" only at the root): abm/data/ holds survey files that are never
# committed and webapp/data/ the local SQLite job store. The one exception is
# water_sampling_points.csv, which is tracked and read by the model at runtime.
**/data/
!abm/data/water_sampling_points.csv
docs/
streamlit_outputs/

# The frontend-builder stage does its own `npm ci` + `npm run build` inside
# the image (see Dockerfile) - a local node_modules/ or a stale local build
# of webapp/frontend_dist/ would only bloat the build context and risk
# shipping outdated JS if ever accidentally relied upon.
frontend/node_modules/
frontend/dist/
webapp/frontend_dist/
e2e-results/
frontend/test-results/
frontend/playwright-report/

# Only the one cached grid the webapp actually uses is needed - matches
# the .gitignore exception pattern.
grids/*
!grids/7d9ce7c720a6/
grids/7d9ce7c720a6/*
!grids/7d9ce7c720a6/grid.npz
